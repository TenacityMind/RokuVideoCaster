<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="args" type="assocarray" onChange="onArgs" />
  </interface>
  <children>
    <!-- Background for Dashboard / Idle Screen -->
    <Rectangle id="bg" width="1920" height="1080" color="0x0b0e14FF" />
    <Rectangle width="1920" height="4" translation="[0, 0]" color="0x38bdf8FF" />

    <!-- Cinematic Dashboard UI (Shown when idle) -->
    <Group id="dashboard" visible="true">
      <Label text="ROKU VIDEO CASTER" horizAlign="center" width="1920" translation="[0, 200]" font="font:LargeBoldSystemFont" color="0x38bdf8FF" />
      <Label id="statusLabel" text="* READY TO CAST" horizAlign="center" width="1920" translation="[0, 260]" font="font:MediumBoldSystemFont" color="0x34d399FF" />

      <!-- Modern Frosted Glass Card -->
      <Rectangle width="1100" height="360" translation="[410, 340]" color="0x121826F6" />
      <Rectangle width="1100" height="2" translation="[410, 340]" color="0x38bdf840" />

      <Label text="HOW TO CAST TO THIS TV" horizAlign="center" width="1100" translation="[410, 365]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" />
      <Label text="Open the Web Dashboard on your Computer or Phone:" horizAlign="center" width="1100" translation="[410, 405]" font="font:MediumSystemFont" color="0xe2e8f0FF" />

      <!-- Prominent High-Contrast URL Display Box -->
      <Rectangle width="720" height="64" translation="[600, 455]" color="0x090c14FF" />
      <Label id="webUrlLabel" text="http://localhost:8080" horizAlign="center" vertAlign="center" width="720" height="64" translation="[600, 455]" font="font:LargeBoldSystemFont" color="0x38bdf8FF" />

      <Label text="Select any local video file or paste an online streaming link." horizAlign="center" width="1100" translation="[410, 545]" font="font:MediumSystemFont" color="0xcfd8e3FF" />
      <Label text="Direct Hardware Passthrough  *  4K HDR  *  Multi-Track Audio  *  Subtitles" horizAlign="center" width="1100" translation="[410, 610]" font="font:SmallSystemFont" color="0x64748bFF" />
      <Label id="deviceInfo" text="Roku TV Native Engine | Version 2.0" horizAlign="center" width="1100" translation="[410, 645]" font="font:SmallSystemFont" color="0x475569FF" />
    </Group>

    <!-- Fullscreen Video Player -->
    <Video id="video" width="1920" height="1080" visible="false" />

    <!-- Subtitle Overlay (Bottom Center, High Contrast) -->
    <Group id="subtitleGroup" visible="false">
      <Label id="subtitleShadow" text="" horizAlign="center" vertAlign="bottom" width="1640" height="180" translation="[142, 832]" font="font:LargeBoldSystemFont" color="0x000000FF" wrap="true" maxLines="3" />
      <Label id="subtitleLabel" text="" horizAlign="center" vertAlign="bottom" width="1640" height="180" translation="[140, 830]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" wrap="true" maxLines="3" />
    </Group>

    <!-- Seek Quick Toast (Left/Right remote keys when video is playing) -->
    <Group id="seekToast" visible="false">
      <Rectangle width="460" height="60" translation="[730, 60]" color="0x090b10F0">
        <Label id="seekToastLabel" text="&gt;&gt; +15s (00:00)" horizAlign="center" vertAlign="center" width="460" height="60" translation="[0, 0]" font="font:MediumBoldSystemFont" color="0x38bdf8FF" />
      </Rectangle>
    </Group>
    <Timer id="seekToastTimer" repeat="false" duration="1.5" />

    <!-- Subtitle position timer (checks every 250ms to update subtitle display) -->
    <Timer id="subtitleTimer" repeat="true" duration="0.25" />

    <!-- ============================================================ -->
    <!-- MAIN PLAYER DECK (Shown when Paused)                         -->
    <!-- ============================================================ -->
    <Group id="deckGroup" visible="false">
      <!-- Dark gradient scrim -->
      <Rectangle width="1920" height="340" translation="[0, 740]" color="0x0b0f19F2" />
      <Rectangle width="1920" height="2" translation="[0, 740]" color="0x38bdf844" />

      <!-- Title & Time Remaining Badge -->
      <Label id="deckTitle" text="NOW PLAYING" translation="[80, 765]" font="font:LargeBoldSystemFont" color="0xffffffff" width="1200" />
      <Label id="deckBadge" text="PAUSED" translation="[80, 815]" font="font:SmallBoldSystemFont" color="0x38bdf8FF" width="200" />
      <Label id="deckTime" text="00:00 / 00:00" translation="[1440, 815]" font="font:MediumBoldSystemFont" color="0x94a3b8FF" horizAlign="right" width="400" />

      <!-- Scrub / Progress Bar -->
      <Rectangle width="1760" height="8" translation="[80, 855]" color="0x334155FF" />
      <Rectangle id="progressBarFill" width="0" height="8" translation="[80, 855]" color="0x38bdf8FF" />
      <Rectangle id="progressDot" width="16" height="16" translation="[72, 851]" color="0xffffffff" />

      <!-- Deck Action Cards -->
      <!-- Card 0: Resume -->
      <Rectangle id="card0Bg" width="360" height="75" translation="[80, 890]" color="0x2563EBEE" />
      <Label id="card0Label" text="&gt; Resume [OK]" translation="[80, 915]" font="font:MediumBoldSystemFont" color="0xffffffff" width="360" horizAlign="center" />

      <!-- Card 1: Subtitles & Audio -->
      <Rectangle id="card1Bg" width="440" height="75" translation="[470, 890]" color="0x1e293bEE" />
      <Label id="card1Label" text="[CC] Subtitles &amp; Audio" translation="[470, 915]" font="font:MediumBoldSystemFont" color="0x94a3b8FF" width="440" horizAlign="center" />

      <!-- Card 2: Next / Stop -->
      <Rectangle id="card2Bg" width="340" height="75" translation="[940, 890]" color="0x1e293bEE" />
      <Label id="card2Label" text="&gt;&gt; Next Video" translation="[940, 915]" font="font:MediumBoldSystemFont" color="0x94a3b8FF" width="340" horizAlign="center" />

      <!-- Help hint -->
      <Label text="Left / Right: Select Card   |   OK: Choose   |   Play: Resume Video   |   Back: Resume" translation="[80, 995]" font="font:SmallSystemFont" color="0x64748bFF" width="1760" />
    </Group>

    <!-- ============================================================ -->
    <!-- SUBTITLE & AUDIO SIDE PANEL DRAWER                           -->
    <!-- ============================================================ -->
    <Group id="subPanelGroup" visible="false">
      <!-- Dark backdrop on right side -->
      <Rectangle width="560" height="1080" translation="[1360, 0]" color="0x0a0f1dFA" />
      <Rectangle width="3" height="1080" translation="[1360, 0]" color="0x38bdf888" />

      <!-- Panel Title -->
      <Label text="SUBTITLES &amp; AUDIO" translation="[1400, 50]" font="font:MediumBoldSystemFont" color="0x38bdf8FF" width="480" />
      <Rectangle width="480" height="1" translation="[1400, 95]" color="0x334155FF" />

      <!-- Row 0: Subtitle Track -->
      <Rectangle id="subRow0Bg" width="480" height="75" translation="[1400, 115]" color="0x2563EBEE" />
      <Label text="Subtitle Track" translation="[1420, 123]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" width="440" />
      <Label id="subRow0Val" text="&lt; English [CC] &gt;" translation="[1420, 150]" font="font:MediumBoldSystemFont" color="0xffffffff" width="440" />

      <!-- Row 1: Subtitle Size -->
      <Rectangle id="subRow1Bg" width="480" height="75" translation="[1400, 205]" color="0x0f172aEE" />
      <Label text="Subtitle Size" translation="[1420, 213]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" width="440" />
      <Label id="subRow1Val" text="&lt; Large (42pt) &gt;" translation="[1420, 240]" font="font:MediumBoldSystemFont" color="0xffffffff" width="440" />

      <!-- Row 2: Text Color -->
      <Rectangle id="subRow2Bg" width="480" height="75" translation="[1400, 295]" color="0x0f172aEE" />
      <Label text="Font Color" translation="[1420, 303]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" width="440" />
      <Label id="subRow2Val" text="&lt; White &gt;" translation="[1420, 330]" font="font:MediumBoldSystemFont" color="0xffffffff" width="440" />

      <!-- Row 3: Sync Timing -->
      <Rectangle id="subRow3Bg" width="480" height="75" translation="[1400, 385]" color="0x0f172aEE" />
      <Label text="Subtitle Sync (Left/Right nudges, OK resets)" translation="[1420, 393]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" width="440" />
      <Label id="subRow3Val" text="&lt; 0.0s (In Sync) &gt;" translation="[1420, 420]" font="font:MediumBoldSystemFont" color="0xffffffff" width="440" />

      <!-- Row 4: Audio Track -->
      <Rectangle id="subRow4Bg" width="480" height="75" translation="[1400, 475]" color="0x0f172aEE" />
      <Label text="Audio Track" translation="[1420, 483]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" width="440" />
      <Label id="subRow4Val" text="&lt; Track 1: Default &gt;" translation="[1420, 510]" font="font:MediumBoldSystemFont" color="0xffffffff" width="440" />

      <!-- Row 5: Done Button -->
      <Rectangle id="subRow5Bg" width="480" height="60" translation="[1400, 565]" color="0x0f172aEE" />
      <Label id="subRow5Val" text="[ Done &amp; Close (OK) ]" translation="[1400, 582]" font="font:MediumBoldSystemFont" color="0x38bdf8FF" width="480" horizAlign="center" />

      <!-- Drawer Help Legend -->
      <Label text="Up / Down: Choose Setting&#xA;Left / Right: Change Value&#xA;OK on Sync: Reset to 0.0s&#xA;Back / OK on Done: Return to Player" translation="[1400, 660]" font="font:SmallSystemFont" color="0x64748bFF" width="480" wrap="true" />
    </Group>
  </children>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
