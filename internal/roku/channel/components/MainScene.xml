<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <interface>
    <field id="args" type="assocarray" onChange="onArgs" />
  </interface>
  <children>
    <!-- Background for Dashboard / Idle Screen -->
    <Rectangle id="bg" width="1920" height="1080" color="0x0b0e14FF" />
    <Rectangle width="1920" height="4" translation="[0, 0]" color="0x38bdf8FF" />

    <!-- Cinematic Dashboard UI (Shown when idle) -->
    <Group id="dashboard" visible="true">
      <Label text="ROKU VIDEO CASTER" horizAlign="center" width="1920" translation="[0, 200]" font="font:LargeBoldSystemFont" color="0x38bdf8FF" />
      <Label id="statusLabel" text="* READY TO CAST" horizAlign="center" width="1920" translation="[0, 260]" font="font:MediumBoldSystemFont" color="0x34d399FF" />

      <!-- Modern Frosted Glass Card -->
      <Rectangle width="1100" height="360" translation="[410, 340]" color="0x121826F6" />
      <Rectangle width="1100" height="2" translation="[410, 340]" color="0x38bdf840" />

      <Label text="HOW TO CAST TO THIS TV" horizAlign="center" width="1100" translation="[410, 365]" font="font:SmallBoldSystemFont" color="0x94a3b8FF" />
      <Label text="Open the Web Dashboard on your Computer or Phone:" horizAlign="center" width="1100" translation="[410, 405]" font="font:MediumSystemFont" color="0xe2e8f0FF" />

      <!-- Prominent High-Contrast URL Display Box -->
      <Rectangle width="720" height="64" translation="[600, 455]" color="0x090c14FF" />
      <Label id="webUrlLabel" text="http://localhost:8080" horizAlign="center" vertAlign="center" width="720" height="64" translation="[600, 455]" font="font:LargeBoldSystemFont" color="0x38bdf8FF" />

      <Label text="Select any local video file or paste an online streaming link." horizAlign="center" width="1100" translation="[410, 545]" font="font:MediumSystemFont" color="0xcfd8e3FF" />
      <Label text="Direct Hardware Passthrough  *  4K HDR  *  Multi-Track Audio  *  Subtitles" horizAlign="center" width="1100" translation="[410, 610]" font="font:SmallSystemFont" color="0x64748bFF" />
      <Label id="deviceInfo" text="Roku TV Native Engine | Version 2.0" horizAlign="center" width="1100" translation="[410, 645]" font="font:SmallSystemFont" color="0x475569FF" />
    </Group>

    <!-- Fullscreen Video Player -->
    <Video id="video" width="1920" height="1080" visible="false" />

    <!-- Subtitle Overlay (Bottom Center, High Contrast) -->
    <Group id="subtitleGroup" visible="false">
      <Label id="subtitleShadow" text="" horizAlign="center" vertAlign="bottom" width="1640" height="180" translation="[142, 832]" font="font:LargeBoldSystemFont" color="0x000000FF" wrap="true" maxLines="3" />
      <Label id="subtitleLabel" text="" horizAlign="center" vertAlign="bottom" width="1640" height="180" translation="[140, 830]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" wrap="true" maxLines="3" />
    </Group>

    <!-- Quick Seek / Status Toast -->
    <Group id="seekToast" visible="false">
      <Rectangle width="460" height="60" translation="[730, 70]" color="0x050608F4">
        <Rectangle width="4" height="60" translation="[0, 0]" color="0xE50914FF" />
        <Label id="seekToastLabel" text="+10s (00:00:00)" horizAlign="center" vertAlign="center" width="460" height="60" translation="[0, 0]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" />
      </Rectangle>
    </Group>
    <Timer id="seekToastTimer" repeat="false" duration="1.5" />

    <!-- Subtitle position timer (checks every 250ms to update subtitle display) -->
    <Timer id="subtitleTimer" repeat="true" duration="0.25" />

    <!-- Deck auto-hide timer (fades OSD after 5s when video is playing) -->
    <Timer id="deckAutoHideTimer" repeat="false" duration="5.0" />

    <!-- ============================================================ -->
    <!-- TOP HEADER OVERLAY (Netflix Title & Format Tags)             -->
    <!-- ============================================================ -->
    <Group id="topHeaderGroup" visible="false">
      <Rectangle width="1920" height="150" translation="[0, 0]" color="0x000000D0" />
      <Label id="deckTitle" text="NOW PLAYING" translation="[80, 52]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" width="1500" />
      <!-- Resolution & Audio Tags on Top Right (Widened to prevent truncation) -->
      <Rectangle width="115" height="30" translation="[1620, 54]" color="0x262626EE" />
      <Label text="4K UHD" width="115" height="30" translation="[1620, 54]" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" color="0xDDDDDDFF" />
      <Rectangle width="65" height="30" translation="[1750, 54]" color="0x262626EE" />
      <Label text="5.1" width="65" height="30" translation="[1750, 54]" horizAlign="center" vertAlign="center" font="font:SmallBoldSystemFont" color="0xDDDDDDFF" />
    </Group>

    <!-- ============================================================ -->
    <!-- MAIN PLAYER DECK (Netflix Bottom Scrim & Scrub Bar)          -->
    <!-- ============================================================ -->
    <Group id="deckGroup" visible="false">
      <!-- Dark bottom scrim -->
      <Rectangle width="1920" height="360" translation="[0, 720]" color="0x000000F5" />

      <!-- Elapsed & Remaining Time Display -->
      <Label id="deckTimeElapsed" text="00:00:00" translation="[80, 810]" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" width="220" />
      <Label id="deckTimeRemaining" text="-00:00:00" translation="[1500, 810]" horizAlign="right" font="font:SmallBoldSystemFont" color="0xAAAAAAFF" width="340" />

      <!-- Scrub Track (1760px span) -->
      <Rectangle id="progressTrack" width="1760" height="6" translation="[80, 845]" color="0x262626FF" />
      <Rectangle id="progressBarFill" width="0" height="6" translation="[80, 845]" color="0xE50914FF" />
      <Rectangle id="progressDot" width="16" height="16" translation="[72, 840]" color="0xFFFFFFFF" />

      <!-- Floating Scene Preview Thumbnail Card (Netflix Style) -->
      <Group id="scrubThumbGroup" visible="false">
        <!-- Sleek Card Container -->
        <Rectangle width="280" height="182" translation="[0, 0]" color="0x0E111AF8" />
        <Rectangle width="280" height="3" translation="[0, 0]" color="0xE50914FF" />
        
        <!-- Elegant Trick-Play Placeholder (displayed when poster is loading or for web streams) -->
        <Rectangle width="280" height="151" translation="[0, 3]" color="0x131826FA" />
        <Label text="PREVIEW" width="280" height="50" translation="[0, 35]" font="font:MediumBoldSystemFont" horizAlign="center" vertAlign="center" color="0xE50914DD" />
        <Label text="SCENE TIME" width="280" height="30" translation="[0, 85]" font="font:SmallBoldSystemFont" horizAlign="center" vertAlign="center" color="0x64748BFF" />
        
        <!-- Dynamic Thumbnail Image (covers placeholder if thumbnail available) -->
        <Poster id="scrubThumbPoster" width="280" height="151" translation="[0, 3]" loadDisplayMode="scaleToFit" />
        
        <!-- Target Time Badge at bottom of preview card -->
        <Rectangle width="280" height="28" translation="[0, 154]" color="0x06080DEE" />
        <Label id="scrubThumbTime" text="00:00:00" width="280" height="28" translation="[0, 154]" font="font:SmallBoldSystemFont" horizAlign="center" vertAlign="center" color="0xFFFFFFFF" />
      </Group>

      <!-- Uniform Netflix Controls Row (Height: 52px) -->
      <!-- Card 0: Play / Pause -->
      <Rectangle id="card0Bg" width="150" height="52" translation="[80, 885]" color="0xE50914FF" />
      <Label id="card0Label" text="Pause" width="150" height="52" translation="[80, 885]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />

      <!-- Card 1: -10 -->
      <Rectangle id="card1Bg" width="120" height="52" translation="[250, 885]" color="0x1E1E24CC" />
      <Label id="card1Label" text="-10" width="120" height="52" translation="[250, 885]" font="font:MediumBoldSystemFont" color="0xCCCCCCFF" horizAlign="center" vertAlign="center" />

      <!-- Card 2: +10 -->
      <Rectangle id="card2Bg" width="120" height="52" translation="[390, 885]" color="0x1E1E24CC" />
      <Label id="card2Label" text="+10" width="120" height="52" translation="[390, 885]" font="font:MediumBoldSystemFont" color="0xCCCCCCFF" horizAlign="center" vertAlign="center" />

      <!-- Card 3: Audio & Caption Icon -->
      <Rectangle id="card3Bg" width="160" height="52" translation="[530, 885]" color="0x1E1E24CC" />
      <Poster id="card3Icon" uri="pkg:/images/audio_sub.png" width="98" height="28" translation="[561, 897]" loadDisplayMode="scaleToFit" />
      <Label id="card3Label" text="" width="1" height="1" visible="false" />

      <!-- Card 4: Next -->
      <Rectangle id="card4Bg" width="130" height="52" translation="[710, 885]" color="0x1E1E24CC" />
      <Label id="card4Label" text="Next" width="130" height="52" translation="[710, 885]" font="font:MediumBoldSystemFont" color="0xCCCCCCFF" horizAlign="center" vertAlign="center" />
    </Group>

    <!-- ============================================================ -->
    <!-- SUBTITLE & AUDIO CENTER MODAL (Netflix Dual Column)          -->
    <!-- ============================================================ -->
    <Group id="subPanelGroup" visible="false">
      <!-- Fullscreen Dimmer -->
      <Rectangle width="1920" height="1080" color="0x000000C8" />

      <!-- Centered Modal Card (1160 x 730) -->
      <Rectangle width="1160" height="730" translation="[380, 175]" color="0x0A0D14FD" />
      <Rectangle width="1160" height="3" translation="[380, 175]" color="0xE50914FF" />

      <!-- Modal Header -->
      <Poster uri="pkg:/images/audio_sub.png" width="70" height="20" translation="[420, 207]" loadDisplayMode="scaleToFit" />
      <Label text="AUDIO &amp; SUBTITLES" translation="[505, 203]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" width="500" />
      <Label text="[Back] to Close" translation="[1360, 205]" font="font:SmallBoldSystemFont" color="0x888888FF" horizAlign="right" width="140" />

      <!-- Top Divider -->
      <Rectangle width="1080" height="1" translation="[420, 245]" color="0x262626FF" />

      <!-- Vertical Column Divider -->
      <Rectangle width="1" height="635" translation="[920, 245]" color="0x262626FF" />

      <!-- ========================================================== -->
      <!-- LEFT COLUMN: AUDIO STREAMS                                 -->
      <!-- ========================================================== -->
      <Label text="AUDIO STREAMS" translation="[420, 270]" font="font:SmallBoldSystemFont" color="0x9CA3AFFF" width="460" />

      <!-- Audio Track 0 -->
      <Rectangle id="audioRow0Bg" width="460" height="56" translation="[420, 305]" color="0x15161DCC" />
      <Label id="audioRow0Val" text="English (5.1 Surround Passthrough)" translation="[438, 322]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" width="390" />
      <Label id="audioRow0Check" text="*" translation="[840, 318]" font="font:LargeBoldSystemFont" color="0xE50914FF" width="30" horizAlign="right" />

      <!-- Audio Track 1 -->
      <Rectangle id="audioRow1Bg" width="460" height="56" translation="[420, 375]" color="0x15161DCC" />
      <Label id="audioRow1Val" text="English (Stereo Downmix)" translation="[438, 392]" font="font:MediumBoldSystemFont" color="0x9CA3AFFF" width="390" />
      <Label id="audioRow1Check" text="" translation="[840, 388]" font="font:LargeBoldSystemFont" color="0xE50914FF" width="30" horizAlign="right" />

      <!-- Audio Track 2 -->
      <Rectangle id="audioRow2Bg" width="460" height="56" translation="[420, 445]" color="0x15161DCC" />
      <Label id="audioRow2Val" text="Alternate Audio" translation="[438, 462]" font="font:MediumBoldSystemFont" color="0x9CA3AFFF" width="390" />
      <Label id="audioRow2Check" text="" translation="[840, 458]" font="font:LargeBoldSystemFont" color="0xE50914FF" width="30" horizAlign="right" />

      <!-- ========================================================== -->
      <!-- RIGHT COLUMN: SUBTITLE OPTIONS                             -->
      <!-- ========================================================== -->
      <Label text="SUBTITLE OPTIONS" translation="[950, 270]" font="font:SmallBoldSystemFont" color="0x9CA3AFFF" width="550" />

      <!-- Section 1: Track -->
      <Label text="TRACK" translation="[950, 302]" font="font:SmallBoldSystemFont" color="0x64748BFF" width="550" />
      <Rectangle id="subTrackPill0Bg" width="265" height="44" translation="[950, 326]" color="0x15161DCC" />
      <Label id="subTrackPill0Val" text="English [CC]" width="265" height="44" translation="[950, 326]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />

      <Rectangle id="subTrackPill1Bg" width="265" height="44" translation="[1235, 326]" color="0x15161DCC" />
      <Label id="subTrackPill1Val" text="Off" width="265" height="44" translation="[1235, 326]" font="font:MediumBoldSystemFont" color="0x9CA3AFFF" horizAlign="center" vertAlign="center" />

      <!-- Section 2: Text Size -->
      <Label text="TEXT SIZE" translation="[950, 384]" font="font:SmallBoldSystemFont" color="0x64748BFF" width="550" />
      <Rectangle id="subSizePill0Bg" width="172" height="42" translation="[950, 408]" color="0x15161DCC" />
      <Label id="subSizePill0Val" text="Normal" width="172" height="42" translation="[950, 408]" font="font:SmallBoldSystemFont" color="0x9CA3AFFF" horizAlign="center" vertAlign="center" />

      <Rectangle id="subSizePill1Bg" width="172" height="42" translation="[1138, 408]" color="0xE50914FF" />
      <Label id="subSizePill1Val" text="Large" width="172" height="42" translation="[1138, 408]" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />

      <Rectangle id="subSizePill2Bg" width="172" height="42" translation="[1326, 408]" color="0x15161DCC" />
      <Label id="subSizePill2Val" text="Huge" width="172" height="42" translation="[1326, 408]" font="font:SmallBoldSystemFont" color="0x9CA3AFFF" horizAlign="center" vertAlign="center" />

      <!-- Section 3: Text Color -->
      <Label text="TEXT COLOR" translation="[950, 464]" font="font:SmallBoldSystemFont" color="0x64748BFF" width="550" />
      <Rectangle id="subColorPill0Bg" width="172" height="42" translation="[950, 488]" color="0xE50914FF" />
      <Label id="subColorPill0Val" text="White" width="172" height="42" translation="[950, 488]" font="font:SmallBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />

      <Rectangle id="subColorPill1Bg" width="172" height="42" translation="[1138, 488]" color="0x15161DCC" />
      <Label id="subColorPill1Val" text="Yellow" width="172" height="42" translation="[1138, 488]" font="font:SmallBoldSystemFont" color="0xFACC15FF" horizAlign="center" vertAlign="center" />

      <Rectangle id="subColorPill2Bg" width="172" height="42" translation="[1326, 488]" color="0x15161DCC" />
      <Label id="subColorPill2Val" text="Sky Blue" width="172" height="42" translation="[1326, 488]" font="font:SmallBoldSystemFont" color="0x38BDF8FF" horizAlign="center" vertAlign="center" />

      <!-- Section 4: Audio & Sub Sync -->
      <Label text="AUDIO &amp; SUB SYNC" translation="[950, 544]" font="font:SmallBoldSystemFont" color="0x64748BFF" width="550" />
      <Rectangle id="syncMinusBg" width="110" height="42" translation="[950, 568]" color="0x15161DCC" />
      <Label id="syncMinusVal" text="- 0.5s" width="110" height="42" translation="[950, 568]" font="font:SmallBoldSystemFont" color="0xCCCCCCFF" horizAlign="center" vertAlign="center" />

      <Rectangle id="syncStatusBg" width="315" height="42" translation="[1075, 568]" color="0x064E3B66" />
      <Label id="syncStatusVal" text="0.0s (In Sync)" width="315" height="42" translation="[1075, 568]" font="font:SmallBoldSystemFont" color="0x34D399FF" horizAlign="center" vertAlign="center" />

      <Rectangle id="syncPlusBg" width="95" height="42" translation="[1405, 568]" color="0x15161DCC" />
      <Label id="syncPlusVal" text="+ 0.5s" width="95" height="42" translation="[1405, 568]" font="font:SmallBoldSystemFont" color="0xCCCCCCFF" horizAlign="center" vertAlign="center" />

      <!-- Section 5: Done / Resume Button -->
      <Rectangle id="subDoneBg" width="550" height="48" translation="[950, 630]" color="0x15161DCC" />
      <Label id="subDoneVal" text="Done &amp; Resume Playback" width="550" height="48" translation="[950, 630]" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" horizAlign="center" vertAlign="center" />
    </Group>
  </children>
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
</component>
